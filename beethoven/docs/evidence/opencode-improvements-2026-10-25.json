    "adoptedPrinciples": [
      "UI lifetime separate from turn lifetime",
      "action errors remain within UI",
      "single execution owner and cleanup distinct from interruption request",
      "child work has explicit owned lifecycle"
    ],
    "migration": "Pi 1.4.0 SDK and existing SQLite retained; no OpenCode code/dependency transplant"
  },
  "fixed": [
    "turn or command exceptions no longer unwind the interactive loop",
    "unknown runtime failure pauses execution until explicit same-session /resume",
    "no automatic retransmission, budget reset or provider fallback",
    "safe dialogue_exit metadata for future exit diagnosis",
    "MGMT-01: ready/start admission and latched cancellation, including during initialization",
    "MGMT-02: await owned process-group disappearance after leader exit",
    "MGMT-03: unbounded active-reservation lookup separate from display pagination",
    "MGMT-04: search yields and validates rules at batches and before publishing results"
  ],
